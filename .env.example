# IncidentFlow MCP — local configuration
# Copy this file to .env. Do not commit .env or put production secrets in it.

# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info
LOG_FORMAT=json
HTTP_SLOW_REQUEST_THRESHOLD_MS=1000
MCP_SLOW_TOOL_THRESHOLD_MS=3000

# Local authentication
# Create a local token with:
#   uv run incidentflow-mcp token create --name local-dev
# Leave empty only for isolated, unauthenticated development.
INCIDENTFLOW_PAT=
# Set explicitly only when local scope enforcement is needed.
# ENFORCE_SCOPES=true

# Platform integration
# Required by workspace-scoped Kubernetes, Grafana, Argo CD, Slack, and
# investigation tools. Docker Compose supplies its own local default.
# PLATFORM_API_BASE_URL=http://host.docker.internal:8000
# PLATFORM_API_INTERNAL_API_KEY=
# MCP_DEFAULT_WORKSPACE_ID=

# OAuth validation
# Set these together when validating access tokens from a local OAuth provider.
# OAUTH_EXPECTED_ISSUER=
# OAUTH_JWKS_URL=
# MCP_CANONICAL_RESOURCE=
# MCP_RESOURCE_METADATA_URL=
AUTH_MODE=dual

# MCP behaviour
MCP_SERVER_NAME=incidentflow-mcp
MCP_SESSION_IDLE_TIMEOUT_SECONDS=1800
MAX_ALERT_CORRELATION_WINDOW_MINUTES=60
# MCP_ASYNC_TOOLS_ENABLED=true
# MCP_STRICT_OUTPUT_VALIDATION=true

# Redis, rate limiting, and tool guards
# For Docker Compose's local Redis profile, use:
# redis://:redis-dev-password@redis:6379/0
REDIS_URL=redis://host.docker.internal:6379/0
RATE_LIMIT_UNAUTH_PER_MIN=20
RATE_LIMIT_AUTHENTICATED_PER_MIN=60
TOOL_LIMIT_AUTHENTICATED_PER_MIN=20
EXPENSIVE_TOOL_LIMIT_PER_MIN=5
TOOL_CONCURRENCY_AUTHENTICATED=2
TOOL_TIMEOUT_SECONDS=30
RATE_LIMIT_UNAUTHENTICATED_BUCKET_SCOPE=ip
RATE_LIMIT_AUTHENTICATED_BUCKET_SCOPE=principal

# Optional per-tool timeout overrides, for example:
# TOOL_TIMEOUT_OVERRIDES=incident_summary=15,correlate_alerts=20
TOOL_TIMEOUT_OVERRIDES=
