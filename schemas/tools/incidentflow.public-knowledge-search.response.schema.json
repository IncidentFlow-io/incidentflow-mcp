            "results": {
              "items": {
                "$ref": "#/$defs/KnowledgeResult"
              },
              "type": "array"
            },
            "scope": {
              "anyOf": [
                {
                  "const": "public",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "total": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
