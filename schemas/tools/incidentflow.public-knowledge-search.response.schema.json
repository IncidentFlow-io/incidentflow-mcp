    "data": {
      "anyOf": [
        {
          "additionalProperties": true,
          "description": "Normalized public search response (review #9).\n\nPermissive until the platform-api search payload is pinned: the handler adapter\nalways surfaces the normalized fields, while upstream extras are tolerated so a\nlive response never fails validation.",
          "properties": {
            "next_cursor": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "query": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
