      "required": [
        "generated_at",
        "truncated",
        "warnings"
      ],
      "type": "object"
    },
    "request_id": {
      "type": "string"
    },
    "schema_id": {
      "const": "incidentflow.public-knowledge-search.response",
      "type": "string"
