                "UNAUTHENTICATED",
                "PERMISSION_DENIED",
                "NOT_FOUND",
                "CONFLICT",
                "RATE_LIMITED",
                "INTEGRATION_UNAVAILABLE",
                "UPSTREAM_ERROR",
                "TIMEOUT",
                "INTERNAL_ERROR"
              ],
              "type": "string"
            },
            "details": {
              "type": [
                "object",
                "array",
                "string",
                "number",
                "boolean",
                "null"
              ]
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
