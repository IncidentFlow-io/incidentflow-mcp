{
  "$id": "https://incidentflow.io/schemas/tools/incidentflow.investigation-get.response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "enum": [
        "v1"
      ],
      "type": "string"
    },
    "data": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "assessed_at": {
              "anyOf": [
                {},
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "assessment": {
              "additionalProperties": true,
              "type": "object"
            },
            "assessment_evidence": {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "array"
            },
            "confidence_level": {
              "default": "unknown",
              "type": "string"
            },
            "current_health": {
              "additionalProperties": true,
              "type": "object"
            },
            "evidence_budget": {
              "default": 0,
              "type": "integer"
            },
            "evidence_summary": {
              "additionalProperties": true,
              "type": "object"
            },
            "evidence_used": {
              "default": 0,
              "type": "integer"
            },
            "id": {
              "type": "string"
            },
            "impact_level": {
              "default": "unknown",
              "type": "string"
            },
            "initial_assessment": {
              "additionalProperties": true,
              "type": "object"
            },
            "latest_assessment": {
              "additionalProperties": true,
              "type": "object"
            },
            "needs_attention": {
              "type": "boolean"
            },
            "passes": {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "array"
            },
            "queued_at": {
              "anyOf": [
                {},
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "recent_timeline": {
              "additionalProperties": true,
              "type": "object"
            },
            "recommended_action": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "resolved_at": {
              "anyOf": [
                {},
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "scope": {
              "additionalProperties": true,
              "type": "object"
            },
            "severity": {
              "type": "string"
            },
            "started_at": {
              "anyOf": [
                {},
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "status": {
              "type": "string"
            },
            "stop_reason": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "summary": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "title": {
              "type": "string"
            },
            "ui_path": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "status",
            "title",
            "severity",
            "needs_attention",
            "scope",
            "ui_path"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "code": {
              "enum": [
                "INVALID_ARGUMENT",
                "UNAUTHENTICATED",
                "PERMISSION_DENIED",
                "NOT_FOUND",
                "CONFLICT",
                "RATE_LIMITED",
                "INTEGRATION_UNAVAILABLE",
                "UPSTREAM_ERROR",
                "TIMEOUT",
                "INTERNAL_ERROR"
              ],
              "type": "string"
            },
            "details": {
              "type": [
                "object",
                "array",
                "string",
                "number",
                "boolean",
                "null"
              ]
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
