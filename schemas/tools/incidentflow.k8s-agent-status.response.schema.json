{
  "$defs": {
    "ClusterConnection": {
      "additionalProperties": true,
      "description": "Shared-dev connection context injected by _with_integration_context.",
      "properties": {
        "cluster": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "environment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "type": "object"
    }
  },
  "$id": "https://incidentflow.io/schemas/tools/incidentflow.k8s-agent-status.response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "enum": [
        "v1"
      ],
      "type": "string"
    },
    "data": {
      "anyOf": [
        {
          "additionalProperties": false,
          "description": "`k8s_agent_status` \u2014 strict. `status` is the integration lifecycle;\n`healthy` the aggregate boolean. `offline` is a valid observed result, not an\nerror, so it stays in `data` (only action-tool failures are hoisted).",
          "properties": {
            "agent_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "agent_status": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "agent_version": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "checked_at": {
              "format": "date-time",
              "type": "string"
            },
            "cluster_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "cluster_name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "connection": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ClusterConnection"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "environment": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "healthy": {
              "type": "boolean"
            },
            "last_heartbeat_at": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "last_seen_at": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "status": {
              "enum": [
                "connected",
                "degraded",
                "offline",
                "stale",
                "not_configured",
                "unknown"
              ],
              "type": "string"
            },
            "warnings": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "status",
            "healthy",
            "checked_at"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "code": {
              "enum": [
                "INVALID_ARGUMENT",
                "UNAUTHENTICATED",
                "PERMISSION_DENIED",
                "NOT_FOUND",
                "CONFLICT",
                "RATE_LIMITED",
                "INTEGRATION_UNAVAILABLE",
                "UPSTREAM_ERROR",
                "TIMEOUT",
                "INTERNAL_ERROR"
              ],
              "type": "string"
            },
            "details": {
              "type": [
                "object",
                "array",
                "string",
                "number",
                "boolean",
                "null"
              ]
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "meta": {
      "additionalProperties": false,
      "properties": {
        "generated_at": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "generated_at",
        "truncated",
        "warnings"
      ],
      "type": "object"
    },
    "request_id": {
      "type": "string"
    },
    "schema_id": {
      "const": "incidentflow.k8s-agent-status.response",
      "type": "string"
    },
    "schema_version": {
      "enum": [
        "1.0"
      ],
      "type": "string"
    },
    "status": {
      "enum": [
        "success",
        "error"
      ],
      "type": "string"
    }
  },
  "required": [
    "api_version",
    "schema_version",
    "schema_id",
    "status",
    "request_id",
    "data",
    "error",
    "meta"
  ],
  "type": "object"
}
