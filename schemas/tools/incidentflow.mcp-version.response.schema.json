{
  "$defs": {
    "MCPVersionImage": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "signature_identity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "signature_issuer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "signature_verified": {
          "type": "boolean"
        },
        "signed": {
          "type": "boolean"
        }
      },
      "required": [
        "signed",
        "signature_verified"
      ],
      "type": "object"
    },
    "MCPVersionTools": {
      "additionalProperties": false,
      "properties": {
        "meta": {
          "type": "integer"
        },
        "operational": {
          "type": "integer"
        },
        "registered": {
          "type": "integer"
        }
      },
      "required": [
        "registered",
        "operational",
        "meta"
      ],
      "type": "object"
    }
  },
  "$id": "https://incidentflow.io/schemas/tools/incidentflow.mcp-version.response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "enum": [
        "v1"
      ],
      "type": "string"
    },
    "data": {
      "anyOf": [
        {
          "additionalProperties": false,
          "description": "`mcp_version` \u2014 fully owned, strict.\n\nVersion fields are named distinctly from the envelope (`current_api_version`,\n`contract_version`) so `data` never duplicates `envelope.api_version` /\n`envelope.schema_version` (review #3, #4).",
          "properties": {
            "built_at": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "commit": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "contract_version": {
              "type": "string"
            },
            "current_api_version": {
              "type": "string"
            },
            "deprecated_api_versions": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "environment": {
              "type": "string"
            },
            "image": {
              "$ref": "#/$defs/MCPVersionImage"
            },
            "service": {
              "type": "string"
            },
            "service_version": {
              "type": "string"
            },
            "supported_api_versions": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "supported_schema_versions": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "tag": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "tools": {
              "$ref": "#/$defs/MCPVersionTools"
            }
          },
          "required": [
            "service",
            "service_version",
            "current_api_version",
            "contract_version",
            "supported_api_versions",
            "supported_schema_versions",
            "deprecated_api_versions",
            "environment",
            "tools",
            "image"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "code": {
              "enum": [
                "INVALID_ARGUMENT",
                "UNAUTHENTICATED",
                "PERMISSION_DENIED",
                "NOT_FOUND",
                "CONFLICT",
                "RATE_LIMITED",
                "INTEGRATION_UNAVAILABLE",
                "UPSTREAM_ERROR",
                "TIMEOUT",
                "INTERNAL_ERROR"
              ],
              "type": "string"
            },
            "details": {
              "type": [
                "object",
                "array",
                "string",
                "number",
                "boolean",
                "null"
              ]
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "meta": {
      "additionalProperties": false,
      "properties": {
        "generated_at": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "generated_at",
        "truncated",
        "warnings"
      ],
      "type": "object"
    },
    "request_id": {
      "type": "string"
    },
    "schema_id": {
      "const": "incidentflow.mcp-version.response",
      "type": "string"
    },
    "schema_version": {
      "enum": [
        "1.0"
      ],
      "type": "string"
    },
    "status": {
      "enum": [
        "success",
        "error"
      ],
      "type": "string"
    }
  },
  "required": [
    "api_version",
    "schema_version",
    "schema_id",
    "status",
    "request_id",
    "data",
    "error",
    "meta"
  ],
  "type": "object"
}
