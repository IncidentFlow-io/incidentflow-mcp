            "deprecated_api_versions": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "environment": {
              "type": "string"
            },
            "image": {
              "type": "object"
            },
            "schema_version": {
              "type": "string"
            },
            "service": {
              "type": "string"
            },
            "service_version": {
              "type": "string"
            },
            "supported_api_versions": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "supported_schema_versions": {
              "items": {
                "type": "string"
