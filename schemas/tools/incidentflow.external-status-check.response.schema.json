{
  "$id": "https://incidentflow.io/schemas/tools/incidentflow.external-status-check.response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "enum": [
        "v1"
      ],
      "type": "string"
    },
    "data": {
      "anyOf": [
        {
          "oneOf": [
            {
              "additionalProperties": true,
              "properties": {
                "job_id": {
                  "type": "string"
                },
                "job_status": {
                  "enum": [
                    "queued",
                    "running",
                    "succeeded",
                    "failed",
                    "cancelled"
                  ],
                  "type": "string"
                },
                "mode": {
                  "const": "async"
                },
                "poll_after_seconds": {
                  "minimum": 1,
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "providers": {
                  "type": "array"
                }
              },
              "required": [
                "mode",
                "job_id",
                "job_status"
              ],
              "type": "object"
            },
            {
              "additionalProperties": true,
              "properties": {
                "check_status": {
                  "enum": [
                    "success",
                    "partial_success",
                    "failed",
                    "unknown"
                  ],
                  "type": "string"
                },
                "checked_at": {
                  "anyOf": [
                    {
                      "format": "date-time",
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "errors": {
                  "type": "array"
                },
                "mode": {
                  "const": "completed"
                },
                "providers": {
                  "type": "array"
                }
              },
              "required": [
                "mode",
                "check_status",
                "providers"
              ],
              "type": "object"
            },
            {
              "additionalProperties": true,
              "properties": {
                "job_id": {
                  "type": "string"
                },
                "job_status": {
                  "enum": [
                    "queued",
                    "running",
                    "succeeded",
                    "failed",
                    "cancelled"
                  ],
                  "type": "string"
                },
                "mode": {
                  "const": "completed"
                },
                "response_mode": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "result": {
                  "type": [
                    "object",
                    "null"
                  ]
                }
              },
              "required": [
                "mode",
                "job_id",
                "job_status"
              ],
              "type": "object"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "code": {
              "enum": [
                "INVALID_ARGUMENT",
                "UNAUTHENTICATED",
                "PERMISSION_DENIED",
                "NOT_FOUND",
                "CONFLICT",
                "RATE_LIMITED",
                "INTEGRATION_UNAVAILABLE",
                "UPSTREAM_ERROR",
                "TIMEOUT",
                "INTERNAL_ERROR"
              ],
              "type": "string"
            },
            "details": {
              "type": [
                "object",
                "array",
                "string",
                "number",
                "boolean",
                "null"
              ]
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "meta": {
      "additionalProperties": false,
      "properties": {
        "generated_at": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "generated_at",
        "truncated",
        "warnings"
      ],
      "type": "object"
    },
    "request_id": {
      "type": "string"
    },
    "schema_id": {
      "const": "incidentflow.external-status-check.response",
      "type": "string"
    },
    "schema_version": {
      "enum": [
        "1.0"
      ],
      "type": "string"
    },
    "status": {
      "enum": [
        "success",
        "error"
      ],
      "type": "string"
    }
  },
  "required": [
    "api_version",
    "schema_version",
    "schema_id",
    "status",
    "request_id",
    "data",
    "error",
    "meta"
  ],
  "type": "object"
}
