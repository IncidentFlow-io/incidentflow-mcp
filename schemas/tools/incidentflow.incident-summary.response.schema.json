{
  "$defs": {
    "Severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "warning",
        "low",
        "info"
      ],
      "type": "string"
    },
    "TimelineEvent": {
      "properties": {
        "actor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "description": {
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "timestamp",
        "description"
      ],
      "type": "object"
    }
  },
  "$id": "https://incidentflow.io/schemas/tools/incidentflow.incident-summary.response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "enum": [
        "v1"
      ],
      "type": "string"
    },
    "data": {
      "anyOf": [
        {
          "additionalProperties": true,
          "properties": {
            "affected_services": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "human_context_from_slack_thread": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "incident_id": {
              "type": "string"
            },
            "memory_context": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "recommendations": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "severity": {
              "$ref": "#/$defs/Severity"
            },
            "status": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "timeline": {
              "items": {
                "$ref": "#/$defs/TimelineEvent"
              },
              "type": "array"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "incident_id",
            "title",
            "severity",
            "status",
            "summary",
            "affected_services",
            "timeline",
            "recommendations"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "code": {
              "enum": [
                "INVALID_ARGUMENT",
                "UNAUTHENTICATED",
                "PERMISSION_DENIED",
                "NOT_FOUND",
                "CONFLICT",
                "RATE_LIMITED",
                "INTEGRATION_UNAVAILABLE",
                "UPSTREAM_ERROR",
                "TIMEOUT",
                "INTERNAL_ERROR"
              ],
              "type": "string"
            },
            "details": {
              "type": [
                "object",
                "array",
                "string",
                "number",
                "boolean",
                "null"
              ]
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "meta": {
      "additionalProperties": false,
      "properties": {
        "generated_at": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "generated_at",
        "truncated",
        "warnings"
      ],
      "type": "object"
    },
    "request_id": {
      "type": "string"
    },
    "schema_id": {
      "const": "incidentflow.incident-summary.response",
      "type": "string"
    },
    "schema_version": {
      "enum": [
        "1.0"
      ],
      "type": "string"
    },
    "status": {
      "enum": [
        "success",
        "error"
      ],
      "type": "string"
    }
  },
  "required": [
    "api_version",
    "schema_version",
    "schema_id",
    "status",
    "request_id",
    "data",
    "error",
    "meta"
  ],
  "type": "object"
}
